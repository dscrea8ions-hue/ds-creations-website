generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ProductAudience {
  SCHOOL
  CORPORATE
  INSTITUTION
  GENERAL
}

enum ProductStockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum FulfilmentType {
  READY_STOCK
  MADE_TO_ORDER
  CUSTOMIZED
}

enum AssetType {
  LOGO
  CATALOGUE
  PRODUCT_IMAGE
  SOCIAL_IMAGE
  OTHER
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         UserRole        @default(ADMIN)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]

  @@index([active, role])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, sortOrder])
}

model Product {
  id                     String             @id @default(cuid())
  name                   String
  slug                   String             @unique
  sku                    String             @unique
  shortDescription       String
  description            String
  categoryId             String
  category               Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory            String?
  audience               ProductAudience
  institutionName        String?
  schoolName             String?
  brand                  String?
  price                  Decimal?           @db.Decimal(12, 2)
  offerPrice             Decimal?           @db.Decimal(12, 2)
  gstPercentage          Decimal            @default(18) @db.Decimal(5, 2)
  minimumOrderQuantity   Int                @default(1)
  stockQuantity          Int                @default(0)
  stockStatus            ProductStockStatus @default(IN_STOCK)
  material               String?
  sizes                  Json
  colours                Json
  weight                 String?
  deliveryTime           String
  fulfilmentType         FulfilmentType     @default(READY_STOCK)
  customizationAvailable Boolean            @default(false)
  embroideryAvailable    Boolean            @default(false)
  printingAvailable      Boolean            @default(false)
  featured               Boolean            @default(false)
  published              Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  images                 ProductImage[]

  @@index([categoryId, published])
  @@index([audience, stockStatus])
  @@index([featured, published])
  @@index([updatedAt])
}

model ProductSkuCounter {
  key       String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  altText   String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, isPrimary, sortOrder])
}

model SiteAsset {
  id        String    @id @default(cuid())
  type      AssetType
  title     String
  url       String
  pathname  String?
  mimeType  String?
  fileSize  Int?
  active    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, active, updatedAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
}
